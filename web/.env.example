# Nata web console — environment template
#
# Copy to `.env.local` and adjust:
#
#     cp web/.env.example web/.env.local
#
# `.env.local` is gitignored. There are no secrets in this file: the console
# holds no credentials, because it reaches Gemini only indirectly, by proxying
# to the Python agent (which authenticates via ADC).

# Where the ADK backend is listening. The console proxies `/api/adk/*` here,
# server-side, so this value never reaches the browser.
#
# Local development:
ADK_SERVER_URL=http://127.0.0.1:48700
#
# Deployed, point it at the agent's Cloud Run URL, e.g.:
# ADK_SERVER_URL=https://nata-agent-<hash>-et.a.run.app
#
# Note: the proxy reads this at REQUEST time, not build time — so the console
# builds fine with the backend down. If you deploy the console without setting
# this, every agent call returns 502 and the build will still look green.
