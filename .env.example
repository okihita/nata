# Nata — environment template
#
# Copy to `.env` and adjust:   cp .env.example .env
#
# `.env` is gitignored — NEVER commit real secrets. This template holds
# placeholders only. There are no API keys here at all: the agent authenticates
# to Gemini through Application Default Credentials (ADC):
#
#     gcloud auth application-default login
#
# For the console, see `web/.env.example`.

# ── Google Cloud ────────────────────────────────────────────────────────────

# Project that hosts Vertex AI, Cloud Run and Secret Manager.
GOOGLE_CLOUD_PROJECT=nata-hackathon

# Vertex AI endpoint location used for Gemini calls.
#
# Gemini models on this project are served ONLY on the `global` endpoint;
# `asia-southeast2` (the project's data region) returns
# "400 FAILED_PRECONDITION" for Gemini. Keep `global` for the model, and use
# `asia-southeast2` for regional services (Cloud Run, Firestore, etc.).
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_CLOUD_LOCATION=asia-southeast2   # data region — NOT valid for Gemini here

# Route Gemini through Google Cloud instead of the Gemini Developer API.
# ADK 2.x renamed GOOGLE_GENAI_USE_VERTEXAI -> GOOGLE_GENAI_USE_ENTERPRISE
# (the old name still works as an alias).
GOOGLE_GENAI_USE_ENTERPRISE=TRUE

# ── Optional ────────────────────────────────────────────────────────────────

# Override the Gemini model id used by the agent.
# Available in this project include gemini-3.8-flash (default), gemini-4-argon.
# NATA_MODEL=gemini-3.8-flash
